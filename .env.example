# Copy this file to .env and set a unique value before starting Docker.
# Generate one with: openssl rand -base64 48
SECRET_KEY=
# Generate a persistent Fernet key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BROWSER_STORAGE_ENCRYPTION_KEY=
ENVIRONMENT=production
CORS_ORIGINS=https://icapsq.mftechnologies.org
GOOGLE_OAUTH_CLIENT_ID=
PAYMENT_PROVIDER=ipay
IPAY_VENDOR_ID=
IPAY_HASH_KEY=
IPAY_LIVE=0
APP_PUBLIC_URL=https://icapsq.mftechnologies.org
RESEND_API_KEY=
RESEND_FROM_EMAIL=info@mftechnologies.org
RESEND_TEST_RECIPIENT=
PASSWORD_RESET_URL=https://icapsq.mftechnologies.org/auth/forgot-password.html
